      "frame": {
        "id": "rag_upgrade",
        "type": "comparison",
        "title": "RAG进阶关键是检索质量",
        "script": "基础 RAG 常见问题是召回不准。进阶做法是语义分块或递归分块，再把向量检索和关键词检索做融合，最后重排序。这样能减少答非所问，也能避免模型只抓到语义相近但业务无关的片段。",
        "left": {
          "label": "基础RAG",
          "color": "ORANGE",
          "points": [
            "固定切块容易切断语义",
            "仅向量检索，精确词命中弱",
            "缺少重排，噪声片段上榜"
          ]
        },
        "right": {
          "label": "进阶RAG",
          "color": "CYAN",
          "points": [
            "语义或递归分块保结构",
            "向量+关键词混合召回",
            "RRF融合后再重排序生成"
          ]
        },
        "insight": "先把检索做准，再讨论生成文风。"
      },
