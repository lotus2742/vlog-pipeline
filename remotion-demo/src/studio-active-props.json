      "durationInFrames": 597,
      "frame": {
        "id": "context_opt",
        "type": "bullets",
        "title": "上下文窗口要做主动压缩",
        "script": "大窗口不等于高质量。输入太长会抬高成本，还会稀释关键信号。文档里给的实操是三步：保留系统提示和核心规则，提炼最近轮次的用户意图，再压缩历史重复内容。RAG 场景只保留与问题相关的段落，别整篇塞进来。",
        "items": [
          {
            "title": "保留硬约束",
            "desc": "系统提示、输出格式、边界条件必须原样保留。"
          },
          {
            "title": "提炼近期意图",
            "desc": "优先保留最近对话中的任务目标与状态变化。"
          },
          {
            "title": "压缩重复历史",
            "desc": "合并同类内容，减少无效 token 占用。"
          },
          {
            "title": "RAG按相关截取",
            "desc": "只放相关段落，不把整份文档直接灌入上下文。"
          }
        ]
      },
      "captionKeywords": [
        "RAG",
